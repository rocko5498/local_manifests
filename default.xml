<?xml version="1.0" encoding="UTF-8"?>
<!--
  OnePlus 11R (udon) - LineageOS 23.2 / Android 16
  Stack: Quantom2 device-common + kernel, lineage-ovaltine-dev vendor blobs.

  Sources confirmed by the project owner 2026-07-25:
    https://gitlab.com/lineage-ovaltine-dev/proprietary_vendor_oneplus/sm8450-common
    https://github.com/Quantom2/android_device_oneplus_sm8450-common-new/tree/lineage-23.2-new-kmod
    https://github.com/Quantom2/android_device_realme_senna/tree/lineage-23.2   (reference tree + patches/apply.sh)
    https://github.com/lineage-ovaltine-dev

  Notes:
  - Quantom2's kernel is a FORK of lineage-ovaltine-dev/android_kernel_oneplus_sm8450.
    Its include/soc/oplus/{boot,dft} are SYMLINKS into a sibling repo
    kernel/oneplus/gki-modules, so that repo MUST be synced or
    generated_kernel_includes fails. Source: lineage-ovaltine-dev/
    android_oneplus_kernel_gki-modules (only branch: lineage-23.2).
  - hardware/oplus stays on pjgowtham per Quantom2 ("use lineage one or
    pjgowtham one, doesn't matter"). Local fixes live there - do not re-point
    without re-applying them.
  - device/oneplus/udon + vendor/oneplus/udon stay on Udon-F-up A16-wip: no
    Quantom2/ovaltine equivalent exists for the udon device tree itself.
  - senna patches/apply.sh carries the ACDB fix (LineageOS gerrit 417220,
    "agm: Support sku agnostic acdb odm path" by pjgowtham) plus the SDM/IRIS
    repopicks - apply separately, not via manifest.
-->
<manifest>
  <remote name="udonfup" fetch="ssh://git@github.com/Udon-F-up" />
  <remote name="pjgowtham-gh" fetch="https://github.com/pjgowtham" />
  <remote name="quantom2-gh" fetch="https://github.com/Quantom2" />
  <remote name="ovaltine-gh" fetch="https://github.com/lineage-ovaltine-dev" />
  <remote name="ovaltine-gl" fetch="https://gitlab.com/lineage-ovaltine-dev/proprietary_vendor_oneplus" />
  <remote name="lineage" fetch="https://github.com/LineageOS" />

  <!-- Device trees -->
  <project path="device/oneplus/udon"
           name="device_oneplus_udon"
           remote="udonfup" revision="A16-wip" />
  <project path="device/oneplus/sm8450-common"
           name="android_device_oneplus_sm8450-common-new"
           remote="quantom2-gh" revision="lineage-23.2-new-kmod" />

  <!-- Vendor blobs -->
  <project path="vendor/oneplus/udon"
           name="vendor_oneplus_udon"
           remote="udonfup" revision="A16-wip" />
  <project path="vendor/oneplus/sm8450-common"
           name="sm8450-common"
           remote="ovaltine-gl" revision="lineage-23.2" />

  <!-- Kernel: Quantom2's (fork of lineage-ovaltine-dev's) + required gki-modules sibling -->
  <project path="kernel/oneplus/sm8450"
           name="android_kernel_oneplus_sm8450"
           remote="ovaltine-gh" revision="lineage-23.2" />
  <project path="kernel/oneplus/gki-modules"
           name="android_oneplus_kernel_gki-modules"
           remote="ovaltine-gh" revision="lineage-23.2" />
  <project path="kernel/oneplus/sm8450-devicetrees"
           name="android_kernel_oneplus_sm8450-devicetrees"
           remote="pjgowtham-gh" revision="lineage-23.2" />
  <project path="kernel/oneplus/sm8450-modules"
           name="android_kernel_oneplus_sm8450-modules"
           remote="ovaltine-gh" revision="lineage-23.2" />

  <!-- Hardware -->
  <project path="hardware/oplus"
           name="android_hardware_oplus"
           remote="pjgowtham-gh" revision="lineage-23.2" />

  <!-- Other chipsets' audio primary-hal: not our device, break `repo manifest -r`. -->
  <remove-project path="hardware/qcom-caf/sm8450-6.6/audio/primary-hal" optional="true" />
  <remove-project path="hardware/qcom-caf/sm8550/audio/primary-hal" optional="true" />
  <remove-project path="hardware/qcom-caf/sm8650/audio/primary-hal" optional="true" />
  <remove-project path="hardware/qcom-caf/sm8750/audio/primary-hal" optional="true" />
</manifest>
